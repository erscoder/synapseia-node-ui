{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synapseia Node",
  "version": "0.8.13",
  "identifier": "network.synapseia.node-ui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Synapseia Node",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.mainnet-beta.solana.com https://devnet.solana.com https://api.testnet.solana.com https://github.com https://objects.githubusercontent.com; img-src 'self' data: asset: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Synapseia Network Node Control Center",
    "longDescription": "Desktop application to run and manage a Synapseia network node with a user-friendly UI. Supports staking, wallet management, and real-time node monitoring.",
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFRjhBMzY3QUUxNzQ3RkMKUldUOFJ4ZXVaNlA0M3BrVVhPTHFQM3pFRXFDQ01Wd1hjU29GYnNleW0zVnB3ejl1cm1LRURqbnEK",
      "endpoints": [
        "https://github.com/erscoder/synapseia-node-ui/releases/latest/download/latest.json"
      ]
    },
    "shell": {
      "open": true
    }
  }
}
